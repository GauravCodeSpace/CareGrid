# ============================================================
# CareGrid AI — Environment Configuration
# Copy this file to .env and update the values
# ============================================================

# --- Application ---
APP_NAME=CareGrid AI
APP_VERSION=1.0.0
DEBUG=false

# --- Database ---
# SQLite (default for development)
DATABASE_URL=sqlite:///data/database.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/caregrid

# --- Security ---
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# --- Google Maps (Optional) ---
# If not provided, Folium (open-source) maps will be used
GOOGLE_MAPS_API_KEY=

# --- Translation ---
# Default language: en (English), hi (Hindi)
DEFAULT_LANGUAGE=en
